{
    name: Lit,
    vertex: {
        attributes: {
            position: vec3,
            normal: {
                type: vec3,
                default: [0.0, 0.0, 1.0]
            },
            tangents: {
                type: vec4,
                default: [1.0, 0.0, 0.0, 1.0]
            },
            color: {
                type: vec4,
                default: [1.0, 1.0, 1.0, 1.0]
            },
            uv0: {
                type: vec2,
                default: [0.0, 0.0]
            }
        },
        nodes: [
            {
                name: default,
                code: `
                    gl_Position = scene.proj * scene.view * model * vec4(position, 1.0);
                `,
                after: main
            },
            {
                name: worldNormal,
                code: `
                    mat3 normalMatrix = mat3(model);
                    outnormal = normalize(normalMatrix * normal);
                    outtangents = vec4(normalMatrix * tangents.xyz, tangents.w);
                `,
                after: default
            }
        ]
    },
    fragment: {
        variables: {
                baseColor: vec4,
                emissiveFactor: vec3,
                normalScale: {
                    type: float,
                    default: 1.0
                },
                metallicFactor: float,
                roughnessFactor: float,
                occlusionStrength: float,
                alphaCutoff: float
        },
        textures: {
            colorTexture: {
                type: sampler2D,
                default: [255, 255, 255, 255]
            },
            normalTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [128, 128, 255, 255]
            },
            metallicRoughnessTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [0, 255, 0, 255]
            },
            occlusionTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [255, 255, 255, 255]
            },
            emissiveTexture: {
                type: sampler2D,
                default: [0, 0, 0, 255]
            }
        }
        using: [normal, tangents, color, uv0],
        out: {
            outColor: vec4
        },
        init: [
            {
                name: litColor,
                code: `
                    outColor = color * baseColor * texture(colorTexture, uv0);
                    if (outColor.a < alphaCutoff) discard;
                `
            },
            {
                name: litNormal,
                code: `
                    vec3 N = normalize(normal);
                    vec3 T = normalize(tangents.xyz);
                    mat3 TBN = mat3(T, cross(N, T) * tangents.w, N);

                    vec3 tangentNormal = texture(normalTexture, uv0).xyz * 2.0 - 1.0;
                    tangentNormal.xy *= normalScale;
                    vec3 shadingNormal = normalize(TBN * tangentNormal);
                `
            },
            {
                name: litMetallicRoughness,
                code: `
                    vec4 metallicRoughness = texture(metallicRoughnessTexture, uv0);
                    float roughness = metallicRoughness.g * roughnessFactor;
                    float metallic = metallicRoughness.b * metallicFactor;
                `
            },
            {
                name: litSharedVariables,
                code: `
                    vec3 diffuse = vec3(0.0);
                    vec3 specular = vec3(0.0);
                `
            }
        ],
        forLight: [
            {
                name: litLights,
                code: `
                    vec3 lightDir;
                    float attenuation;
                    switch (light.kind)
                    {
                    case 0u:
                        lightDir = normalize(-light.positionRadius.xyz);
                        attenuation = shadow;
                        break;
                    default:
                    {
                        vec3 posToLight = light.positionRadius.xyz - worldPos;
                        float lightDist = length(posToLight);
                        if (lightDist >= light.positionRadius.w) continue;
                        lightDir = posToLight / lightDist;
                        float falloffWindow = clamp(1.0 - pow(lightDist / light.positionRadius.w, 4.0), 0.0, 1.0);
                        attenuation = falloffWindow * falloffWindow;
                        break;
                    }
                    }

                    vec3 radiance = light.colorIntensity.rgb * light.colorIntensity.a * attenuation;

                    float NdotL = max(dot(shadingNormal, lightDir), 0.0);
                    diffuse += radiance * NdotL;

                    vec3 halfDir = normalize(lightDir + viewDir);
                    float shininess = mix(4.0, 256.0, 1.0 - roughness);
                    float spec = pow(max(dot(shadingNormal, halfDir), 0.0), shininess);
                    specular += radiance * spec;
                `
            }
        ],
        post: [
            {
                name: litLightEnd,
                code: `
                    vec3 ambient = vec3(0.03);
                    vec3 specColor = mix(vec3(1.0), outColor.rgb, metallic);
                    outColor.rgb = outColor.rgb * (ambient + diffuse) + specColor * specular * (1.0 - roughness);
                `
            },
            {
                name: litOcclusion,
                code: `
                    float occlusion = texture(occlusionTexture, uv0).r;
                    outColor.rgb *= mix(1.0, occlusion, occlusionStrength);
                `
            },
            {
                name: litEmissive,
                code: `
                    vec3 emissive = texture(emissiveTexture, uv0).rgb * emissiveFactor;
                    outColor.rgb += emissive;
                `
            }
        ],

        alphaMode: opaque,
	    cullMode: back,
	    polygonMode: fill
    }
}