{
    name: LitDetailMap,
    imports: Lit,

    vertex: {
        attributes: {
            uv1: vec2
        },
        variables: [
            {
                detailStrength: float,
                detailOffset: vec2
            }
        ]
    },
    fragment: {
        textures: {
            detailMap: sampler2D
        },
        using: [uv1],
        nodes: [
            {
                name: detailMap,
                code: `
                    vec4 detailColor = texture(detailMap, uv1);
                    outColor = outColor * detailColor;
                `,
                after: litMain
            }
        ]
    }
}