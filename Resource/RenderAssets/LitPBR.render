{
    name: LitPBR,
    flags: ["useLighting"]
    vertex: {
        attributes: {
            position: vec3,
            normal: {
                type: vec3,
                default: [0.0, 0.0, 1.0]
            },
            tangents: {
                type: vec4,
                default: [0.0, 0.0, 0.0, 0.0]
            },
            color: {
                type: vec4,
                default: [1.0, 1.0, 1.0, 1.0]
            },
            uv0: {
                type: vec2,
                default: [0.0, 0.0]
            }
        },
        nodes: [
            {
                name: default,
                code: `
                    gl_Position = scene.proj * scene.view * model * vec4(position, 1.0);
                `,
                after: main
            },
            {
                name: worldNormal,
                code: `
                    mat3 normalMatrix = mat3(model);
                    outnormal = normalize(normalMatrix * normal);
                    outtangents = vec4(normalMatrix * tangents.xyz, tangents.w);
                `,
                after: default
            }
        ]
    },
    fragment: {
        variables: {
            baseColor: vec4,
            emissiveFactor: vec3,
            normalScale: {
                type: float,
                default: 1.0
            },
            metallicFactor: float,
            roughnessFactor: float,
            occlusionStrength: float,
            alphaCutoff: float
        },
        textures: {
            colorTexture: {
                type: sampler2D,
                default: [255, 255, 255, 255]
            },
            normalTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [128, 128, 255, 255]
            },
            metallicRoughnessTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [0, 255, 0, 255]
            },
            occlusionTexture: {
                type: sampler2D,
                colorSpace: unorm,
                default: [255, 255, 255, 255]
            },
            emissiveTexture: {
                type: sampler2D,
                default: [0, 0, 0, 255]
            }
        }
        using: [normal, tangents, color, uv0],
        out: {
            outColor: vec4
        },
        functions: [
            {
                name: constants,
                code: `
                    #define PI 3.14159265359
                `
            },
            {
                name: fresnelSchlick,
                code: `
                    vec3 fresnelSchlick(float cosTheta, vec3 F0)
                    {
                        return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
                    }
                `
            },
            {
                name: DistributionGGX,
                code: `
                    float DistributionGGX(vec3 N, vec3 H, float roughness)
                    {
                        float a = roughness * roughness;
                        float a2 = a * a;
                        float NdotH = max(dot(N, H), 0.0);
                        float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;

                        return a2 / (PI * denom * denom);
                    }
                `
            },
            {
                name: VisibilityHammon,
                code: `
                    float VisibilityHammon(float NdotL, float NdotV, float alpha)
                    {
                        return 0.5 / max(mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha), 1e-4);
                    }
                `
            },
            {
                name: DiffuseHammon,
                code: `
                    vec3 DiffuseHammon(vec3 albedo, float alpha, float NdotL, float NdotV, float NdotH, float LdotV)
                    {
                        float facing = 0.5 + 0.5 * LdotV;
                        float rough = facing * (0.9 - 0.4 * facing) * ((0.5 + NdotH) / max(NdotH, 1e-2));
                        float viewFalloff = max(1.0 - pow(1.0 - NdotV, 5.0), 0.35);
                        float smoothTerm = 1.05 * (1.0 - pow(1.0 - NdotL, 5.0)) * viewFalloff;
                        float single = mix(smoothTerm, rough, alpha) / PI;
                        float multi = 0.1159 * alpha;

                        return albedo * (single + albedo * multi);
                    }
                `
            }
        ]
        nodes: [
            {
                name: litColor,
                code: `
                    outColor = color * baseColor * texture(colorTexture, uv0);
                    if (outColor.a < alphaCutoff) discard;
                `,
                after: main
            },
            {
                name: litNormal,
                code: `
                    vec3 N = normalize(normal);
                    vec3 T = normalize(tangents.xyz);
                    mat3 TBN = mat3(T, cross(N, T) * tangents.w, N);

                    vec3 tangentNormal = texture(normalTexture, uv0).xyz * 2.0 - 1.0;
                    tangentNormal.xy *= normalScale;
                    vec3 shadingNormal = normalize(TBN * tangentNormal);
                `,
                after: litColor
            },
            {
                name: litMetallicRoughness,
                code: `
                    vec4 metallicRoughness = texture(metallicRoughnessTexture, uv0);
                    float roughness = metallicRoughness.g * roughnessFactor;
                    float metallic = metallicRoughness.b * metallicFactor;
                    float alpha = roughness * roughness;
                `,
                after: litNormal
            },
            {
                name: litLightStart,
                code: `
                    vec2 clusterNdc = (gl_FragCoord.xy / clusterInfo.screenAndTile.xy) * 2.0 - 1.0;
                    vec4 clusterView = clusterInfo.invProj * vec4(clusterNdc, gl_FragCoord.z, 1.0);
                    clusterView /= clusterView.w;
                    vec3 worldPos = (clusterInfo.invView * vec4(clusterView.xyz, 1.0)).xyz;

                    float clusterNear = clusterInfo.zParams.x;
                    float clusterFar = clusterInfo.zParams.y;
                    uint clusterSlice = uint(max(float(clusterInfo.clusterDims.z) * log(-clusterView.z / clusterNear) / log(clusterFar / clusterNear), 0.0));
                    clusterSlice = min(clusterSlice, clusterInfo.clusterDims.z - 1u);
                    uvec2 clusterTile = uvec2(gl_FragCoord.xy / clusterInfo.screenAndTile.zw);
                    uint clusterIndex = clusterSlice * clusterInfo.clusterDims.x * clusterInfo.clusterDims.y
                                      + clusterTile.y * clusterInfo.clusterDims.x + clusterTile.x;

                    vec3 viewDir = normalize(clusterInfo.invView[3].xyz - worldPos);
                    vec3 F0 = mix(vec3(0.04), outColor.rgb, metallic);
                    float NdotV = max(dot(shadingNormal, viewDir), 0.0);

                    vec3 lightOut = vec3(0.0);

                    uvec2 clusterGrid = lightGrid[clusterIndex];
                    for (uint clusterI = 0u; clusterI < clusterGrid.y; clusterI++)
                    {
                        ClusterLight light = clusterLights[lightIndices[clusterGrid.x + clusterI]];

                        vec3 lightDir;
                        float attenuation;
                        switch (light.kind)
                        {
                        case 0u:   // directional: constant direction, no attenuation
                            lightDir = normalize(-light.positionRadius.xyz);
                            attenuation = SampleDirectionalShadow(light.shadowIndex, worldPos, -clusterView.z);
                            break;
                        default:   // point: attenuate by distance, skip if outside radius
                        {
                            vec3 clusterToLight = light.positionRadius.xyz - worldPos;
                            float lightDist = length(clusterToLight);
                            if (lightDist >= light.positionRadius.w) continue;
                            lightDir = clusterToLight / lightDist;
                            attenuation = 1.0 - lightDist / light.positionRadius.w;
                            break;
                        }
                        }

                        vec3 radiance = light.colorIntensity.rgb * light.colorIntensity.a * attenuation;
                        vec3 halfDir = normalize(viewDir + lightDir);
                `,
                after: litMetallicRoughness
            },
            {
                name: litDiffuse,
                code: `
                        float NdotL = dot(shadingNormal, lightDir);
                        if (NdotL <= 0.0) continue;

                        float NdotH = max(dot(shadingNormal, halfDir), 0.0);
                        float LdotV = dot(lightDir, viewDir);

                        vec3 albedo = (1.0 - metallic) * outColor.rgb;
                        vec3 diffuse = DiffuseHammon(albedo, alpha, NdotL, NdotV, NdotH, LdotV);
                `,
                after: litLightStart,
                before: litLightEnd
            },
            {
                name: litSpecular,
                code: `
                        float NDF = DistributionGGX(shadingNormal, halfDir, roughness);
                        float V = VisibilityHammon(NdotL, NdotV, alpha);
                        vec3 F = fresnelSchlick(max(dot(halfDir, viewDir), 0.0), F0);

                        vec3 specular = NDF * V * F;
                `,
                after: litDiffuse,
                before: litLightEnd
            },
            {
                name: litLightOut,
                code: `
                        lightOut += (diffuse + specular) * radiance * NdotL;
                `,
                after: litSpecular,
                before: litLightEnd
            },
            {
                name: litLightEnd,
                code: `
                    }
                    float occlusion = texture(occlusionTexture, uv0).r;
                    vec3 ambient = vec3(0.03) * outColor.rgb * mix(1.0, occlusion, occlusionStrength);
                    outColor = vec4(ambient + lightOut, outColor.a);
                `,
                after: litLightStart
            },
            {
                name: litEmissive,
                code: `
                    vec3 emissive = texture(emissiveTexture, uv0).rgb * emissiveFactor;
                    outColor.rgb += emissive;
                `,
                after: litLightEnd
            },
            {
                name: litTone,
                code: `
                    vec3 toneColor = outColor.rgb / (outColor.rgb + vec3(1.0));
                    outColor = vec4(toneColor, outColor.a);
                `,
                after: litEmissive
            }
        ],

        alphaMode: opaque,
	    cullMode: back,
	    polygonMode: fill
    }
}
